<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Manifiesto de xdir.exe (lo embebe assets/xdir.rc).
     Declara compatibilidad con Windows 10/11: sin esto Windows trata al exe como de Windows 7
     y, entre otras cosas, no permite ventanas hijas en capas (las cajas de texto opacas sobre Mica).
     El DPI no se declara acá: lo configura main.rs con SetProcessDpiAwarenessContext. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="xdir" version="0.1.0.0" processorArchitecture="amd64"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
